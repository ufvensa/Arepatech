# Supabase Configuration
# Get these values from your Supabase project dashboard:
# https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Calendar API Configuration
# Required for displaying events on the Events page
# Get API key from: https://console.cloud.google.com/apis/credentials
# Calendar IDs are comma-separated (no spaces)

VITE_GOOGLE_CALENDAR_API_KEY=your-google-calendar-api-key-here
VITE_GOOGLE_CALENDAR_IDS=calendar1@gmail.com,calendar2@group.calendar.google.com

# Google Drive Configuration (for Previous Events photos)
# Uses the same Google Cloud project as Calendar above.
# Enable "Google Drive API" in your Cloud Console.
# Share your parent events folder as "Anyone with the link can view".
# The folder ID is the last part of the folder URL:
#   https://drive.google.com/drive/folders/FOLDER_ID_HERE

VITE_GOOGLE_DRIVE_API_KEY=your-google-api-key-here
VITE_GOOGLE_DRIVE_FOLDER_ID=your-parent-folder-id-here

# Backend API URL (for RSVP counts, etc.)
# Set this to your deployed server URL in production
# Defaults to http://localhost:5000 for local development
VITE_API_URL=http://localhost:5000

# Newsletter sending secrets are intentionally absent here.
# RESEND_API_KEY and SUPABASE_SERVICE_ROLE_KEY belong only in Supabase Edge Function secrets.
